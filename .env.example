# Required
DATABASE_URL=postgresql://user:password@localhost:5432/suivipro
JWT_SECRET=your-secret-key-min-32-chars

# Optional: encryption key for Google OAuth tokens (64 hex chars = 32 bytes)
ENCRYPTION_KEY=

# Optional: restrict CORS to your frontend origin
CORS_ORIGIN=http://localhost:5173

# Optional: server port (default 3000)
PORT=3000

# Optional: Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional: set to 'production' for stricter SSL
NODE_ENV=development

# Hub LBDP integration
VITE_HUB_API_URL=https://backend-hub.railway.app/api
VITE_HUB_FRONTEND_URL=https://frontend-hub.railway.app
VITE_HUB_CHANNEL_ID=id-du-canal
VITE_HUB_EMAIL=guillaume@...
VITE_HUB_PASSWORD=mot-de-passe

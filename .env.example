# Required
DATABASE_URL=postgresql://user:password@localhost:5432/suivipro
JWT_SECRET=your-secret-key-min-32-chars

# Optional: encryption key for sensitive data (64 hex chars = 32 bytes)
ENCRYPTION_KEY=

# Optional: restrict CORS to your frontend origin
CORS_ORIGIN=http://localhost:5173

# Optional: server port (default 3000)
PORT=3000

# Optional: Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional: set to 'production' for stricter SSL
NODE_ENV=development

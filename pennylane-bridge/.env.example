# ============================================
# Passerelle EasyBeer -> Pennylane
# ============================================
# Toutes ces variables sont OPTIONNELLES : la config peut aussi se faire
# directement dans l'interface web (onglet "Configuration").
# Les variables d'environnement sont PRIORITAIRES sur la config enregistree.

# --- Serveur ---
PORT=4000

# --- EasyBeer (source) ---
EASYBEER_API_URL=https://api.easybeer.fr
EASYBEER_USERNAME=
EASYBEER_PASSWORD=

# --- Pennylane (destination) ---
PENNYLANE_API_URL=https://app.pennylane.com/api/external/v2
PENNYLANE_TOKEN=

# --- Options de synchronisation ---
# true = les factures sont creees finalisees dans Pennylane, false = en brouillon
PENNYLANE_FINALIZE=false
# Code pays par defaut pour les clients (ISO alpha-2)
DEFAULT_COUNTRY=FR
# Devise par defaut
DEFAULT_CURRENCY=EUR
# Intervalle de synchro automatique en minutes (0 = desactive)
SYNC_INTERVAL_MIN=0

# --- Webhook EasyBeer (optionnel) ---
# Secret partage : EasyBeer doit appeler POST /api/webhook/easybeer/<secret>
WEBHOOK_SECRET=
